# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# The packaged methodology skills are authored once, in @uptimizr/agent-core, and
# copied into @uptimizr/mcp by its build so both tarballs ship them (#316).
oss/packages/mcp/skills/

# Test / coverage
coverage/
.nyc_output/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Env / secrets
.env
.env.*
!.env.example

# Local Uptimizr project registry (project id → dev API key map)
.uptimizr/

# Editor / OS
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Personal, untracked scratch notes (never committed)
.local/

# Docker / data volumes
infra/docker/data/
clickhouse-data/
postgres-data/

# DuckDB (OSS single-file store, ADR 0020) — canonical store lives at <repo-root>/data/
*.duckdb
*.duckdb.wal
*.duckdb.tmp/
/data/
oss/apps/collector-server/data/

# Godot import cache of the web-export sample project (examples/godot-web-export)
examples/godot-web-export/.godot/

# Agent-eval run artefacts (the committed baseline in eval/ is NOT ignored)
oss/packages/agent-eval/report.md
oss/packages/agent-eval/report.json
