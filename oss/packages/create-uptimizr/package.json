{
  "name": "create-uptimizr",
  "version": "1.1.0",
  "description": "Scaffold a self-host of the Uptimizr OSS 3D-analytics collector — Docker-free, single-file DuckDB by default, or backed by Postgres / ClickHouse / SQL Server. Run with `npm create uptimizr@latest`.",
  "keywords": [
    "uptimizr",
    "analytics",
    "3d",
    "create",
    "scaffold",
    "cli",
    "starter"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaananW/Uptimizr.git",
    "directory": "oss/packages/create-uptimizr"
  },
  "bugs": {
    "url": "https://github.com/RaananW/Uptimizr/issues"
  },
  "homepage": "https://uptimizr.com/docs/quickstart/",
  "author": "Raanan Weber (https://github.com/RaananW)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "create-uptimizr": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "vitest": "^4.1.11"
  }
}
