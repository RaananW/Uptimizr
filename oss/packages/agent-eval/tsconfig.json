{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // The package is private and always run through `tsx`, so it emits nothing —
    // `typecheck` is the only compiler pass it needs.
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
