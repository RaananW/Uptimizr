{
  "name": "@uptimizr/db-mssql",
  "version": "1.0.0",
  "description": "Optional single-tenant Microsoft SQL Server store for Uptimizr — composes the @uptimizr/db dialect-agnostic query layer and CollectorStore contract for self-hosters standardized on SQL Server / Azure SQL who want a multi-writer relational backend.",
  "keywords": [
    "uptimizr",
    "analytics",
    "mssql",
    "sql-server",
    "azure-sql",
    "storage",
    "query",
    "events"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaananW/Uptimizr.git",
    "directory": "oss/packages/db-mssql"
  },
  "bugs": {
    "url": "https://github.com/RaananW/Uptimizr/issues"
  },
  "homepage": "https://uptimizr.com/docs/deploy/collector/",
  "author": "Raanan Weber (https://github.com/RaananW)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@uptimizr/db": "workspace:*",
    "@uptimizr/schema": "workspace:*",
    "mssql": "^12.7.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  }
}
