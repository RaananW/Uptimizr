      "until": {
        "description": "End of the time range, epoch milliseconds.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "bins": {
        "description": "Grid resolution per axis.",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 500
      },
      "scene": {
        "description": "Restrict to one developer-assigned scene id.",
        "type": "string"
      },
      "source": {
        "description": "Restrict a pointer/world heatmap to one input source.",
        "type": "string",
        "enum": [
          "mouse",
          "touch",
          "stylus",
          "pen",
          "xr-controller",
          "hand",
          "gaze",
          "transient",
          "other"
        ]
      },
      "session": {
        "description": "Scope the aggregate to a single session id.",
        "type": "string"
      }
    },
    "additionalProperties": false
  },
