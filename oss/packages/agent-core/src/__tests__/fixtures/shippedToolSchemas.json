      "until": {
        "description": "End of the time range, epoch milliseconds.",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "scene": {
        "description": "Restrict to one developer-assigned scene id.",
        "type": "string"
      },
      "cameraMode": {
        "description": "Camera navigation mode to scope to: 'viewer' (orbit) or 'first-person' (walkable).",
        "type": "string",
        "enum": ["viewer", "first-person"]
      },
      "steps": {
        "type": "string",
        "minLength": 1,
        "description": "Funnel steps as a JSON-encoded array of ordered step predicates (ADR 0038). Required. Each step is `{ \"type\": <event_type>, ... }`; e.g. `[{\"type\":\"scene_change\",\"to\":\"lobby\"},{\"type\":\"mesh_interaction\",\"mesh\":\"buy\"}]`."
      }
    },
    "required": ["steps"],
    "additionalProperties": false
  },
