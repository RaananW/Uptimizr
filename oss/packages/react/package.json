{
  "name": "@uptimizr/react",
  "version": "0.13.0",
  "description": "Embeddable React analytics panels for the Uptimizr collector — the complete, portable OSS panel catalog (sessions, pointer/world/view-direction heatmaps, mesh leaderboards, flow, divergence, performance, and more). Reads the collector query API through a shared client; configure once with <UptimizrProvider>. Babylon.js is an optional, code-split peer.",
  "keywords": [
    "uptimizr",
    "analytics",
    "3d",
    "react",
    "hooks",
    "provider",
    "privacy"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaananW/Uptimizr.git",
    "directory": "oss/packages/react"
  },
  "bugs": {
    "url": "https://github.com/RaananW/Uptimizr/issues"
  },
  "homepage": "https://uptimizr.com/docs/deploy/dashboard/",
  "author": "Raanan Weber (https://github.com/RaananW)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./panels-3d": {
      "types": "./dist/panels3d.d.ts",
      "import": "./dist/panels3d.js"
    },
    "./assistant": {
      "types": "./dist/assistant/index.d.ts",
      "import": "./dist/assistant/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@babylonjs/core": "^7.0.0 || ^8.0.0 || ^9.0.0",
    "@babylonjs/loaders": "^7.0.0 || ^8.0.0 || ^9.0.0",
    "@mlc-ai/web-llm": "^0.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@babylonjs/core": {
      "optional": true
    },
    "@babylonjs/loaders": {
      "optional": true
    },
    "@mlc-ai/web-llm": {
      "optional": true
    }
  },
  "dependencies": {
    "@uptimizr/agent-core": "workspace:*",
    "@uptimizr/heatmap": "workspace:*",
    "@uptimizr/replay": "workspace:*",
    "@uptimizr/schema": "workspace:*"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.20.0",
    "@babylonjs/loaders": "^9.20.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^4.1.10"
  }
}
