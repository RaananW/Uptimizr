---
const questions = [
  "What was the most-clicked mesh this week?",
  "Which objects do people see but never touch?",
  "Did frame rate get worse, and on which devices?",
  "Where does our configurator funnel lose people?",
];
const points = [
  {
    title: "Works with your agent",
    body: "Connect Claude, VS Code or Cursor through the included MCP server, or use the assistant built into the dashboard.",
  },
  {
    title: "Grounded in real metrics",
    body: "Every metric reaches the agent with its units, sample caveats and capture channels, so a thin sample doesn't read as a finding.",
  },
  {
    title: "Read-only by default",
    body: "A scoped key limits the agent to one project's aggregates. It can't change events, and every request is audited.",
  },
];
---

<section id="agents" class="section">
  <div class="container agents">
    <div class="agents__copy">
      <p class="eyebrow reveal">Analytics your AI agent can read</p>
      <h2 class="reveal">Ask your 3D analytics in plain English</h2>
      <p class="lead reveal">
        Skip the dashboard when you have a quick question. An AI agent can query your own collector
        directly and answer from your real data.
      </p>
      <a
        class="btn btn--ghost reveal"
        href="/docs/learn/ai-agent-3d-analytics/"
        data-track="cta_click"
        data-track-location="agents"
        data-track-target="docs">See how it works</a
      >
    </div>
    <ul class="agents__questions reveal" aria-label="Example questions">
      {questions.map((q) => <li>{q}</li>)}
    </ul>
  </div>
  <div class="container grid grid--3 agents__points">
    {
      points.map((p, i) => (
        <article class="card reveal" style={`transition-delay:${(i % 3) * 60}ms`}>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .agents {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.4rem;
    align-items: center;
  }
  .agents__copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
    min-width: 0;
  }
  .agents__questions {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }
  .agents__questions li {
    padding: 0.75rem 1rem;
    border: 1px solid var(--edge);
    border-radius: 0.7rem;
    background: var(--panel);
    color: var(--fg-hi);
    font-size: 0.95rem;
  }
  .agents__points {
    margin-top: 2.4rem;
  }
  .agents__points h3 {
    margin-bottom: 0.4rem;
  }
  .agents__points p {
    color: var(--fg-muted);
  }
  @media (max-width: 820px) {
    .agents {
      grid-template-columns: 1fr;
    }
  }
</style>
