<section id="guides" class="section section--alt">
  <div class="container">
    <p class="eyebrow reveal">Learn</p>
    <h2 class="reveal">Guides for measuring 3D on the web</h2>
    <p class="lead reveal">
      Practical answers to the questions teams ask once a 3D scene goes live, whichever tools you
      use.
    </p>
    <div class="grid grid--3 guides">
      {
        guides.map((g, i) => (
          <a class="card guide reveal" href={g.href} style={`transition-delay:${(i % 3) * 60}ms`}>
            <h3>{g.title}</h3>
            <p>{g.body}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .guides {
    margin-top: 2.4rem;
  }
  .guide {
    display: block;
    color: inherit;
