    href: "/docs/learn/",
  },
  {
    title: "Track object clicks in three.js",
    body: "Log clicks with a Raycaster, or use a connector to rank objects across sessions.",
    href: "/docs/learn/track-object-clicks-threejs/",
  },
  {
    title: "Google Analytics and 3D scenes",
    body: "What GA4 can and can't tell you about a WebGL scene, and how to use both.",
    href: "/docs/learn/google-analytics-3d-scenes/",
  },
  {
    title: "Session replay for WebGL",
    body: "Why replays of 3D scenes often come back blank, and how event-based replay differs.",
    href: "/docs/learn/webgl-session-replay/",
  },
  {
