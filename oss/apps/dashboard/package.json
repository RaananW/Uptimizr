{
  "name": "@uptimizr/dashboard",
  "version": "1.1.3",
  "description": "Uptimizr analytics dashboard — a static-export SPA that reads the collector query API. Serve it standalone, all-in-one via the collector, or drop the assets on any static host.",
  "keywords": [
    "uptimizr",
    "analytics",
    "dashboard",
    "nextjs",
    "3d",
    "heatmap",
    "visualization"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaananW/Uptimizr.git",
    "directory": "oss/apps/dashboard"
  },
  "bugs": {
    "url": "https://github.com/RaananW/Uptimizr/issues"
  },
  "homepage": "https://uptimizr.com/docs/deploy/dashboard/",
  "author": "Raanan Weber (https://github.com/RaananW)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "uptimizr-dashboard": "./server/standalone.mjs"
  },
  "files": [
    "out",
    "server",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "llms.txt"
  ],
  "scripts": {
    "dev": "dotenv -e ../../../.env -- next dev -p 3000",
    "build": "next build",
    "build:static": "cross-env DASHBOARD_STATIC=1 next build",
    "prepack": "cross-env DASHBOARD_STATIC=1 next build",
    "start": "next start -p 3000",
    "serve:static": "node server/standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf .next out"
  },
  "dependencies": {
    "@babylonjs/core": "^9.27.1",
    "@babylonjs/loaders": "^9.27.1",
    "@mlc-ai/web-llm": "^0.2.85",
    "@uptimizr/heatmap": "workspace:*",
    "@uptimizr/react": "workspace:*",
    "@uptimizr/replay": "workspace:*",
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
