{
  "name": "@uptimizr/collector-server",
  "version": "2.2.1",
  "description": "Uptimizr ingestion + query API (Fastify). Self-hostable collector for the OSS data-collector.",
  "keywords": [
    "uptimizr",
    "analytics",
    "collector",
    "ingestion",
    "fastify",
    "server",
    "3d",
    "privacy"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaananW/Uptimizr.git",
    "directory": "oss/apps/collector-server"
  },
  "bugs": {
    "url": "https://github.com/RaananW/Uptimizr/issues"
  },
  "homepage": "https://uptimizr.com/docs/deploy/collector/",
  "author": "Raanan Weber (https://github.com/RaananW)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "uptimizr": "./dist/cli.js",
    "uptimizr-collector": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -e ../../../.env -- tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@uptimizr/agent-core": "workspace:*",
    "@uptimizr/db": "workspace:*",
    "@uptimizr/db-clickhouse": "workspace:*",
    "@uptimizr/db-mssql": "workspace:*",
    "@uptimizr/db-postgres": "workspace:*",
    "@uptimizr/mcp": "workspace:*",
    "@uptimizr/metrics": "workspace:*",
    "@uptimizr/schema": "workspace:*",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
