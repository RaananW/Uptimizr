{
  "name": "@uptimizr/demo",
  "version": "0.0.13",
  "private": true,
  "type": "module",
  "description": "Backend-less, fully in-browser demo of Uptimizr (demo.uptimizr.com): the playground feeds an in-browser DuckDB-Wasm store that the dashboard reads via a service-worker collector shim. No hosted database, nothing leaves the browser.",
  "scripts": {
    "predev": "node scripts/prepare-embeds.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-embeds.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "prepare-embeds": "node scripts/prepare-embeds.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist public/playground public/dashboard",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@uptimizr/db": "workspace:*",
    "@uptimizr/schema": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uptimizr/dashboard": "workspace:*",
    "@uptimizr/example-playground": "workspace:*",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
